<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================== -->
    <!-- PARENT : Spring Boot Starter Parent (gestion des versions) -->
    <!-- ===================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- Chercher le parent dans le dépôt Maven -->
    </parent>

    <!-- ===================================================== -->
    <!-- INFORMATIONS DU PROJET                                 -->
    <!-- ===================================================== -->
    <groupId>ma.gov.sante.dsi</groupId>
    <artifactId>dsi-dashboard-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>DSI Dashboard Backend</name>
    <description>
        Tableau de bord de suivi des activités de la Direction des Systèmes
        d'Information (DSI) du Ministère de la Santé
    </description>

    <!-- ===================================================== -->
    <!-- PROPRIÉTÉS GLOBALES DU PROJET                         -->
    <!-- ===================================================== -->
    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- Version de la bibliothèque JWT (JJWT) -->
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <!-- ===================================================== -->
    <!-- DÉPENDANCES                                            -->
    <!-- ===================================================== -->
    <dependencies>

        <!-- === -->
        <!-- 1. SPRING WEB : API REST (contrôleurs, HTTP, JSON) -->
        <!-- === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- === -->
        <!-- 2. SPRING DATA JPA : ORM, accès base de données    -->
        <!-- === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- === -->
        <!-- 3. SPRING SECURITY : Authentification & Autorisations -->
        <!-- === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- === -->
        <!-- 4. VALIDATION : Bean Validation (JSR-380)           -->
        <!--    Pour valider les champs des entités et DTOs      -->
        <!-- === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- === -->
        <!-- 5. POSTGRESQL : Driver JDBC pour la base de données -->
        <!-- === -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- === -->
        <!-- 6. JWT (JJWT) : Génération et validation des tokens -->
        <!--    Décomposé en 3 modules :                         -->
        <!-- === api       : Interfaces publiques             -->
        <!-- === impl      : Implémentation                   -->
        <!-- === jackson   : Sérialisation JSON               -->
        <!-- === -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- === -->
        <!-- 7. LOMBOK : Réduction du code boilerplate           -->
        <!--    (@Getter, @Setter, @Builder, @NoArgsConstructor) -->
        <!-- === -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- === -->
        <!-- 8. MAPSTRUCT : Mapping entre entités et DTOs        -->
        <!-- === -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.5.5.Final</version>
        </dependency>

        <!-- === -->
        <!-- 9. SPRINGDOC OPENAPI : Documentation Swagger/OpenAPI-->
        <!--    Accessible via /swagger-ui.html                  -->
        <!-- === -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- === -->
        <!-- 10. TESTS : JUnit 5, Mockito, Spring Test          -->
        <!-- === -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================== -->
    <!-- PLUGINS DE BUILD                                       -->
    <!-- ===================================================== -->
    <build>
        <plugins>

            <!-- Plugin principal Spring Boot (package, run) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclure Lombok du JAR final (annotations seulement) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Plugin compilateur : configure Lombok + MapStruct ensemble -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- Lombok doit être déclaré AVANT MapStruct -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.5.5.Final</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
